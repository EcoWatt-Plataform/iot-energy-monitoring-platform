[Unit]
Description=EcoWatt Backend (Flask)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ecowatt/app/backend
EnvironmentFile=/etc/ecowatt-backend.env
ExecStart=/opt/ecowatt/app/backend/.venv/bin/python -m app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
